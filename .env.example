# Azure OpenAI Configuration
AZURE_OPENAI_KEY_GPT_5_NANO=your-azure-openai-api-key
AI_FOUNDRY_ENDPOINT_GPT_5_NANO=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Deployment IDs for different models
AZURE_DEPLOYMENT_GPT4_MINI=gpt-4.1-mini

# Semgrep Configuration (if used)
SEMGREP_APP_TOKEN=your-semgrep-app-token

# Application Settings
ENVIRONMENT=development
